<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <!-- Na Windows budujemy i uruchamiamy tylko target Windows. MacCatalyst jest dostępny tylko na macOS. -->
        <!-- DODANO: net10.0; na początku każdego warunku -->
        <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">net10.0;net10.0-windows10.0.19041.0</TargetFrameworks>
        <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('osx'))">net10.0;net10.0-maccatalyst</TargetFrameworks>
        <TargetFrameworks Condition="'$(TargetFrameworks)' == ''">net10.0;net10.0-windows10.0.19041.0</TargetFrameworks>

        <!-- DODANO: Aplikacja to Exe dla platform, ale zwykła biblioteka dla czystego profilu testowego -->
        <OutputType Condition="'$(TargetFramework)' != 'net10.0'">Exe</OutputType>
        <OutputType Condition="'$(TargetFramework)' == 'net10.0'">Library</OutputType>
        
        <RootNamespace>TelemetryApp</RootNamespace>
        <UseMaui>true</UseMaui>
        <SingleProject>true</SingleProject>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>

        <ApplicationTitle>TelemetryApp</ApplicationTitle>
        <ApplicationId>com.companyname.telemetryapp</ApplicationId>
        <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
        <ApplicationVersion>1</ApplicationVersion>

        <WindowsPackageType>None</WindowsPackageType>

        <!-- RuntimeIdentifier dla MacCatalyst zostawiamy Visual Studio/.NET SDK, żeby nie próbować odpalać MacCatalyst na Windows. -->
        
        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
        <TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
    </PropertyGroup>

    <ItemGroup>
        <MauiIcon Update="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#512BD4" />
        <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#512BD4" BaseSize="128,128" />
        <MauiImage Include="Resources\Images\*" />
        <MauiImage Update="Resources\Images\dotnet_bot.png" Resize="True" BaseSize="300,185" />
        <MauiFont Include="Resources\Fonts\*" />
        <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="CommunityToolkit.Maui" Version="13.0.0" />
        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
        <PackageReference Include="LiveChartsCore.SkiaSharpView.Maui" Version="2.0.0-rc5" />
        <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.10" />
        <PackageReference Include="Microsoft.Maui.Essentials" Version="10.0.10" />
        <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
        
        <PackageReference Include="SkiaSharp" Version="3.119.1" /> 
        <PackageReference Include="SkiaSharp.Views.Maui.Controls" Version="3.119.1" />
        
        <PackageReference Include="sqlite-net-pcl" Version="1.9.172" />
        
        <PackageReference Include="System.IO.Ports" Version="10.0.2" />
    </ItemGroup>

    <ItemGroup>
      <MauiXaml Update="Frontend\ViewModels\SessionDetailPage\DetachedPlotPage.xaml">
        <Generator>MSBuild:Compile</Generator>
      </MauiXaml>
    </ItemGroup>

    <PropertyGroup Condition="$(TargetFramework.Contains('-maccatalyst'))">
        <InvariantGlobalization>true</InvariantGlobalization>
        <MtouchExtraArgs>$(MtouchExtraArgs) --setenv:SKIA_SKIP_OPENGL_TEST=1</MtouchExtraArgs>
    </PropertyGroup>

</Project>