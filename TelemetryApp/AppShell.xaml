<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="TelemetryApp.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:TelemetryApp"
    xmlns:views="clr-namespace:TelemetryApp.Frontend.Views"
    Title="Telemetry App"
    Shell.FlyoutBehavior="Flyout">


    <FlyoutItem Title="Sesje"
                Icon="sessions_icon.png">
        <ShellContent
            Title="Sesje"
            ContentTemplate="{DataTemplate views:SessionsPage}"
            Route="SessionsPage"/>
    </FlyoutItem>
    <FlyoutItem Title="Dashboard"
                Icon="dashboard.icon.png">
        <ShellContent Title="Dashboard"
                      ContentTemplate="{DataTemplate views:SessionDetailPage}"
                      Route="SessionDetailPage"/>
    </FlyoutItem>
    <FlyoutItem Title="Ustawienia">
        <ShellContent
            Title="Ustawienia"
            ContentTemplate="{DataTemplate views:SettingsPage}"
            Route="SettingsPage"/>
    </FlyoutItem>

</Shell>
