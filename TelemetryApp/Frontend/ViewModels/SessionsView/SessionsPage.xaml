<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="TelemetryApp.Frontend.Views.SessionsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Name="PageRoot"
    Title="Sesje">
    <VerticalStackLayout Padding="12" Spacing="10">
        <Button Text="Wczytaj sesje" Command="{Binding LoadSessionFromPickerCommand}" />
        <CollectionView ItemsSource="{Binding Sessions}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Padding="8" Margin="4" HasShadow="True">
                        <HorizontalStackLayout VerticalOptions="Center">
                            <Label Text="{Binding Name}" VerticalOptions="Center" />
                            <Button Text="Open"
                                    Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.OpenSessionCommand}"
                                    CommandParameter="{Binding .}"
                                    HorizontalOptions="End" />
                        </HorizontalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </VerticalStackLayout>
</ContentPage>