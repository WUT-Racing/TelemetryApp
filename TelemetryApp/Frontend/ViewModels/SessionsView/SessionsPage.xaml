<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="TelemetryApp.Frontend.Views.SessionsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Name="PageRoot"
    Title="Sesje"
    BackgroundColor="{StaticResource mainGray}">
    <VerticalStackLayout Padding="12"
            Spacing="10"
            VerticalOptions="Center">
        <Button Text="Wczytaj sesje"
                Command="{Binding LoadSessionFromPickerCommand}"
                BackgroundColor="{StaticResource mainRed}"/>
        <Button Text="Utwórz nową sesję"
                Command="{Binding CreateNewSessionCommand}"
                BackgroundColor="{StaticResource mainRed}"/>
    </VerticalStackLayout>
</ContentPage>