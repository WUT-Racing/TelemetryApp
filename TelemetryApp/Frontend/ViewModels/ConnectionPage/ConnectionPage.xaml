<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="TelemetryApp.Frontend.Views.ConnectionPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    x:Name="PageRoot"
    Title="Połączenie">

    <Grid Padding="20" RowDefinitions="Auto, Auto, *" RowSpacing="14">

        <Frame Grid.Row="0"
               Padding="12"
               CornerRadius="12"
               BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#111827}"
               BorderColor="{AppThemeBinding Light=#CBD5E1, Dark=#334155}">
            <Grid RowDefinitions="Auto, Auto" ColumnDefinitions="Auto, 240, Auto, Auto, Auto, Auto, Auto, *" ColumnSpacing="10" RowSpacing="8">
                <Label Grid.Row="0" Grid.Column="0"
                       Text="Sesja"
                       FontAttributes="Bold"
                       VerticalOptions="Center"/>
                <Entry Grid.Row="0" Grid.Column="1"
                       Text="{Binding SessionName}"
                       Placeholder="Nazwa sesji"
                       HeightRequest="42"/>
                <Button Grid.Row="0" Grid.Column="2"
                        Text="Użyj domyślnej"
                        Command="{Binding UseDefaultSessionNameCommand}"/>
                <Button Grid.Row="0" Grid.Column="3"
                        Text="Start session"
                        Command="{Binding StartSessionCommand}"/>
                <Button Grid.Row="0" Grid.Column="4"
                        Text="End session"
                        Command="{Binding EndSessionCommand}"/>

                <Label Grid.Row="0" Grid.Column="5"
                        Text="Kierowca"
                        VerticalOptions="Center"
                        FontAttributes="Bold"/>
                <Picker x:Name="DriverPicker"
                        Grid.Row="0" Grid.Column="6"
                        ItemsSource="{Binding Drivers}"
                        SelectedItem="{Binding SelectedDriver}"
                        ItemDisplayBinding="{Binding Name}"
                        HeightRequest="45"
                        VerticalOptions="Start"
                        WidthRequest="180"/>

                <Label Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="6"
                       Text="{Binding ActiveSessionText}"
                       TextColor="{AppThemeBinding Light=#475569, Dark=#CBD5E1}"
                       LineBreakMode="WordWrap"/>
            </Grid>
        </Frame>

        <Grid Grid.Row="1"
              ColumnDefinitions="Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto"
              ColumnSpacing="10"
              HeightRequest="50">
            <Label Grid.Column="0"
                   Text="Client"
                   VerticalOptions="Center"/>

            <toolkit:Expander Grid.Column="1"
                              WidthRequest="300"
                              VerticalOptions="Start">
                <toolkit:Expander.Header>
                    <Border Padding="10"
                            HeightRequest="45">
                        <Grid ColumnDefinitions="*, Auto">
                            <Label Grid.Column="0"
                                   Text="{Binding SelectedPort, TargetNullValue='Wybierz port...'}"
                                   LineBreakMode="TailTruncation"
                                   VerticalOptions="Center"/>
                            <Label Grid.Column="1"
                                   Text="▼"
                                   TextColor="Gray"
                                   VerticalOptions="Center"/>
                        </Grid>
                    </Border>
                </toolkit:Expander.Header>

                <toolkit:Expander.Content>
                    <Border StrokeThickness="1">
                        <CollectionView ItemsSource="{Binding AvailablePorts}"
                                        SelectionMode="Single"
                                        SelectedItem="{Binding SelectedPort}"
                                        HeightRequest="200">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Label Text="{Binding .}"
                                           Padding="10"
                                           LineBreakMode="WordWrap"/>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </Border>
                </toolkit:Expander.Content>
            </toolkit:Expander>

            <Button Grid.Column="2"
                    Text="🔄"
                    WidthRequest="50"
                    Command="{Binding ScanPortsCommand}"
                    VerticalOptions="Start"
                    HeightRequest="45"/>
            <Label Grid.Column="3"
                   Text="Baud"
                   VerticalOptions="Center"/>
            <Entry Grid.Column="4"
                   Text="{Binding BaudRate}"
                   Keyboard="Numeric"
                   WidthRequest="100"
                   VerticalOptions="Start"
                   HeightRequest="45"/>
            <Button Grid.Column="5"
                    Text="{Binding ConnectionButtonText}"
                    Command="{Binding ConnectCommand}"
                    VerticalOptions="Start"
                    HeightRequest="45"/>

            <Button Grid.Column="6"
                    Text="{Binding SimulatorButtonText}"
                    Command="{Binding StartSimulatorCommand}"
                    VerticalOptions="Start"
                    HeightRequest="45"/>

            <Button Grid.Column="7"
                    Text="Dashboard"
                    Command="{Binding GoToDashboardCommand}"
                    VerticalOptions="Start"
                    HeightRequest="45"/>
        </Grid>

        <Editor Grid.Row="2"
                Text="{Binding ClientText}"
                IsReadOnly="True"
                AutoSize="TextChanges"
                MinimumHeightRequest="420"/>
    </Grid>
</ContentPage>
