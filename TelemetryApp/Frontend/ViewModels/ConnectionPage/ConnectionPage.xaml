<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="TelemetryApp.Frontend.Views.ConnectionPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    x:Name="PageRoot"
    Title="Połączenie">

<Grid RowDefinitions="Auto, Auto, Auto, *"
    RowSpacing="10"
    Padding="20">
        <HorizontalStackLayout Grid.Row="0" Spacing="10" Padding="20">
            <Label HeightRequest="20">Client</Label>
            <Picker Title="Wybierz port" ItemsSource="{Binding AvailablePorts}" SelectedItem="{Binding SelectedPort}"><Picker.Behaviors>
        <toolkit:EventToCommandBehavior
            EventName="Focused"
            Command="{Binding ScanPortsCommand}" />
    </Picker.Behaviors></Picker>
            <Button Text="Connect" Command="{Binding ConnectCommand}"/>
        </HorizontalStackLayout>
        <Editor Grid.Row="1" Text="{Binding ClientText}"
                IsReadOnly="True"
                AutoSize="TextChanges"
                MinimumHeightRequest="300"
                MaximumHeightRequest="300"/>
        <HorizontalStackLayout Grid.Row="2" Spacing="10" Padding="20">
            <Label HeightRequest="20">Server</Label>
            <Button Text="Connect"/>
        </HorizontalStackLayout>
        <Editor Grid.Row="4" Text="{Binding ServerConsoleText}"
                IsReadOnly="True"
                AutoSize="TextChanges"
                MinimumHeightRequest="10"
                MaximumHeightRequest="300"/>
</Grid>

</ContentPage>