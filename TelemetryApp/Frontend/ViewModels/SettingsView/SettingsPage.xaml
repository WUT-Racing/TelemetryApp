<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="TelemetryApp.Frontend.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Name="PageRoot"
    Title="Ustawienia"
    BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource mainGray}}">

    <Grid RowDefinitions="Auto, *">
        <HorizontalStackLayout Grid.Row="0" Spacing="10" Padding="10">
            <Button Text="Ogólne" Command="{Binding SelectTabCommand}" CommandParameter="General" />
            <Button Text="Dane" Command="{Binding SelectTabCommand}" CommandParameter="Data" />
            <Button Text="Eksport" Command="{Binding SelectTabCommand}" CommandParameter="Export" />
        </HorizontalStackLayout>

        <Grid Grid.Row="1" Padding="20">
            <VerticalStackLayout IsVisible="False" Spacing="14">
                <Label Text="Ustawienia ogólne" FontSize="24" FontAttributes="Bold" />
                <Label Text="Motyw aplikacji" FontSize="18" FontAttributes="Bold" />
                <Label Text="Wybierz jeden z dwóch motywów. Ustawienie zostanie zapamiętane po restarcie aplikacji." />

                <HorizontalStackLayout Spacing="10">
                    <Button Text="Jasny" Command="{Binding UseLightThemeCommand}" />
                    <Button Text="Ciemny" Command="{Binding UseDarkThemeCommand}" />
                </HorizontalStackLayout>

                <Label Text="{Binding SelectedTheme, StringFormat='Aktualny motyw: {0}'}"
                       FontAttributes="Bold" />

                <VerticalStackLayout.Triggers>
                    <DataTrigger TargetType="VerticalStackLayout" Binding="{Binding CurrentTab}" Value="General">
                        <Setter Property="IsVisible" Value="True" />
                    </DataTrigger>
                </VerticalStackLayout.Triggers>
            </VerticalStackLayout>

            <VerticalStackLayout IsVisible="False" Spacing="14">
                <Label Text="Ustawienia danych" FontSize="24" FontAttributes="Bold" />

                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <Entry Placeholder="Nazwa kierowcy"
                        Text="{Binding NewDriverName}" />
                    <Button Grid.Column="1"
                            Text="Dodaj"
                            Command="{Binding AddDriverCommand}" />
                </Grid>

                <CollectionView ItemsSource="{Binding Drivers}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="*,Auto" Padding="0,4">
                                <Entry Text="{Binding Name, Mode=TwoWay}"
                                    Placeholder="Nazwa" />
                                <Button Grid.Column="1"
                                        Text="✕"
                                        Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.DeleteDriverCommand}"
                                        CommandParameter="{Binding .}"
                                        BackgroundColor="Transparent"
                                        TextColor="Red"
                                        FontAttributes="Bold"
                                        WidthRequest="44"
                                        HeightRequest="44" />
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <Label Text="Na razie dane live są trzymane w pamięci dashboardu i raw logu .rfdlog. Kolejne opcje zapisu dodamy później." />

                <VerticalStackLayout.Triggers>
                    <DataTrigger TargetType="VerticalStackLayout" Binding="{Binding CurrentTab}" Value="Data">
                        <Setter Property="IsVisible" Value="True" />
                    </DataTrigger>
                </VerticalStackLayout.Triggers>
            </VerticalStackLayout>

            <VerticalStackLayout IsVisible="False" Spacing="14">
                <Label Text="Eksport" FontSize="24" FontAttributes="Bold" />
                <Label Text="Eksportuje aktualną sesję do folderu z plikami CSV. CSV ma separator średnika, UTF-8 BOM i format zgodny z Excelem." />

                <HorizontalStackLayout Spacing="10">
                    <CheckBox IsChecked="{Binding IncludeEnumsInExport}" />
                    <Label Text="Dołącz enumy/statusy do eksportu decoded_signals" VerticalOptions="Center" />
                </HorizontalStackLayout>

                <Button Text="Eksportuj aktualną sesję do CSV"
                        Command="{Binding ExportCurrentSessionCommand}" />

                <Label Text="{Binding ExportStatus}" LineBreakMode="WordWrap" />

                <VerticalStackLayout.Triggers>
                    <DataTrigger TargetType="VerticalStackLayout" Binding="{Binding CurrentTab}" Value="Export">
                        <Setter Property="IsVisible" Value="True" />
                    </DataTrigger>
                </VerticalStackLayout.Triggers>
            </VerticalStackLayout>
        </Grid>
    </Grid>
</ContentPage>
