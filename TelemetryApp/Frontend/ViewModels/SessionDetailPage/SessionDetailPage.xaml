<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TelemetryApp.Frontend.Views.SessionDetailPage"
             Title="Edytor Dashboardu"
             x:Name="ThisPage">

    <VerticalStackLayout>
        <Button Text="Dodaj wykres" Command="{Binding AddPlotCommand}" />
        <Button Text="Synchronizuj wykresy" Command="{Binding SynchronizePlotsCommand}" />
        <Button Text="Zatrzymaj aktualizowanie" Command="{Binding StartStopCommand}"/>
    </VerticalStackLayout>

</ContentPage>