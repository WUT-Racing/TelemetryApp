<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="TelemetryApp.Frontend.Views.DetachedPlotPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.Maui;assembly=LiveChartsCore.SkiaSharpView.Maui"
    xmlns:controls="clr-namespace:TelemetryApp.Frontend.Controls"
    x:Name="PageRoot"
    Title="{Binding Title}">

    <Grid Padding="14"
          RowDefinitions="Auto, Auto, *, Auto, Auto"
          ColumnDefinitions="*, Auto, Auto"
          RowSpacing="8"
          ColumnSpacing="8">

        <VerticalStackLayout Grid.Row="0"
                             Grid.Column="0"
                             Spacing="2">
            <Label Text="{Binding Title}"
                   FontAttributes="Bold"
                   FontSize="18"
                   LineBreakMode="TailTruncation" />

            <Label Text="{Binding LastValueText}"
                   FontSize="13"
                   TextColor="{AppThemeBinding Light=#64748B, Dark=#CBD5E1}" />
        </VerticalStackLayout>

        <Button Grid.Row="0"
                Grid.Column="1"
                Text="Przypnij"
                Command="{Binding OwnerViewModel.ReattachPlotCommand, Source={x:Reference PageRoot}}"
                CommandParameter="{Binding .}" />

        <Button Grid.Row="0"
                Grid.Column="2"
                Text="Usuń"
                TextColor="Red"
                BackgroundColor="Transparent"
                FontAttributes="Bold"
                Command="{Binding OwnerViewModel.RemovePlotCommand, Source={x:Reference PageRoot}}"
                CommandParameter="{Binding .}" />

        <Grid Grid.Row="1"
              Grid.ColumnSpan="3"
              ColumnDefinitions="Auto, *"
              ColumnSpacing="10">

            <Label Grid.Column="0"
                   Text="Sygnał:"
                   VerticalOptions="Start"
                   Margin="0,8,0,0" />

            <Grid Grid.Column="1"
                  RowDefinitions="Auto, Auto"
                  RowSpacing="4">

                <Grid ColumnDefinitions="*, Auto"
                      ColumnSpacing="6">

                    <Entry Grid.Column="0"
                           Text="{Binding SignalSearchText, Mode=TwoWay}"
                           Placeholder="Wpisz nazwę, CAN ID, klucz albo jednostkę..."
                           ClearButtonVisibility="WhileEditing"
                           Focused="OnSignalSearchFocused"
                           Completed="OnSignalSearchCompleted" />

                    <Button Grid.Column="1"
                            Text="▾"
                            WidthRequest="44"
                            Command="{Binding OpenSignalSearchCommand}" />
                </Grid>

                <Border Grid.Row="1"
                        IsVisible="{Binding IsSignalSearchOpen}"
                        BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E293B}"
                        Padding="0"
                        HeightRequest="210"
                        ZIndex="100">

                    <CollectionView ItemsSource="{Binding FilteredSignals}"
                                    SelectionMode="Single"
                                    SelectionChanged="OnSignalSearchSelectionChanged">

                        <CollectionView.EmptyView>
                            <Grid Padding="12">
                                <Label Text="Brak pasujących sygnałów."
                                       TextColor="Gray" />
                            </Grid>
                        </CollectionView.EmptyView>

                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="10,8"
                                      RowDefinitions="Auto, Auto">
                                    <Label Text="{Binding DisplayName}"
                                           FontAttributes="Bold"
                                           LineBreakMode="TailTruncation" />

                                    <Label Grid.Row="1"
                                           Text="{Binding Key}"
                                           FontSize="12"
                                           TextColor="Gray"
                                           LineBreakMode="TailTruncation" />
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Border>
            </Grid>
        </Grid>

        <Grid Grid.Row="2"
      Grid.ColumnSpan="3">

            <lvc:CartesianChart
        BackgroundColor="#111827"
        Series="{Binding Series}"
        XAxes="{Binding XAxes}"
        YAxes="{Binding YAxes}"
        Sections="{Binding Sections}">

                <lvc:CartesianChart.GestureRecognizers>
                    <PointerGestureRecognizer
                PointerPressed="OnPointerPressed"
                PointerMoved="OnPointerMoved"
                PointerReleased="OnPointerReleased" />
                </lvc:CartesianChart.GestureRecognizers>
            </lvc:CartesianChart>

            <Label Text="Czas"
           HorizontalOptions="Center"
           VerticalOptions="End"
           Margin="0,0,0,2"
           FontSize="12"
           TextColor="#CBD5E1" />
        </Grid>

        <Grid Grid.Row="3"
              Grid.ColumnSpan="3"
              ColumnDefinitions="Auto, *, Auto"
              ColumnSpacing="10">

            <Label Grid.Column="0"
                   Text="Zakres:"
                   VerticalOptions="Center" />

            <controls:RangeSliderView Grid.Column="1"
                                      Minimum="0"
                                      Maximum="{Binding TimelineMaximumSeconds}"
                                      LowerValue="{Binding RangeStartSeconds, Mode=TwoWay}"
                                      UpperValue="{Binding RangeEndSeconds, Mode=TwoWay}"
                                      IsEnabled="{Binding HasTimeline}" />

            <Button Grid.Column="2"
                    Text="Na żywo"
                    Command="{Binding JumpToLiveCommand}" />
        </Grid>

        <Label Grid.Row="4"
               Grid.ColumnSpan="3"
               Text="{Binding ScrollText}"
               FontSize="12"
               TextColor="{AppThemeBinding Light=#64748B, Dark=#CBD5E1}" />
    </Grid>
</ContentPage>