<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TelemetryApp.Frontend.Views.SensorManagementPage"
             Title="Zarządzanie sensorami"
             Padding="10">
    <Grid RowDefinitions="Auto, *">
        <Label Text="Edytuj nazwy sensorów (zmiany będą widoczne w statystykach)"
               FontSize="14"
               Margin="0,0,0,10"/>
        <CollectionView Grid.Row="1" ItemsSource="{Binding Sensors}">
            <CollectionView.Header>
                <Grid BackgroundColor="{StaticResource mainGray}" Padding="10,5"
                      ColumnDefinitions="Auto, *">
                    <Label Text="ID" TextColor="{StaticResource White}" FontAttributes="Bold"/>
                    <Label Grid.Column="1" Text="Nazwa sensora" TextColor="{StaticResource White}" FontAttributes="Bold"/>
                </Grid>
            </CollectionView.Header>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="10,5" ColumnDefinitions="Auto, *"
                          BackgroundColor="{StaticResource Gray600}">
                        <Label Text="{Binding SensorId}" 
                               TextColor="{StaticResource White}"
                               VerticalOptions="Center"/>
                        <Entry Grid.Column="1" 
                               Text="{Binding SensorName, Mode=TwoWay}"
                               TextColor="{StaticResource White}"
                               BackgroundColor="{StaticResource Gray500}"
                               Placeholder="Nazwa sensora"
                               Margin="10,0,0,0"/>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>